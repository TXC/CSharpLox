{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Tokenize": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "tokenize test.lox",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Parser": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "parse test.lox",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Evaluate": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "evaluate test.lox",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Tooling.GenerateAST": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "generate_ast data",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  }
}
